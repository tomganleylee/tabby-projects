{
  "name": "tabby-projects",
  "version": "0.1.0",
  "description": "Project workspaces for Tabby: a project rail on the left, per-project tabs on top, a remote file browser and edit-in-place for remote files.",
  "keywords": [
    "tabby",
    "tabby-plugin",
    "projects",
    "workspaces",
    "ssh",
    "sftp"
  ],
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "link:tabby": "node scripts/link-into-tabby.js",
    "unlink:tabby": "node scripts/link-into-tabby.js --remove"
  },
  "peerDependencies": {
    "@angular/common": "^15.0.0",
    "@angular/core": "^15.0.0",
    "@angular/forms": "^15.0.0",
    "tabby-core": "*",
    "tabby-settings": "*",
    "tabby-ssh": "*",
    "tabby-terminal": "*"
  },
  "devDependencies": {
    "@angular/common": "^15.2.6",
    "@angular/core": "^15.2.6",
    "@angular/forms": "^15.2.6",
    "@types/node": "^18.19.0",
    "rxjs": "^7.8.0",
    "tabby-core": "^1.0.231-nightly.0",
    "tabby-settings": "^1.0.231-nightly.0",
    "tabby-ssh": "^1.0.231-nightly.0",
    "tabby-terminal": "^1.0.231-nightly.0",
    "ts-loader": "^9.5.1",
    "typescript": "~4.9.5",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "zone.js": "^0.13.0"
  },
  "tabbyPlugin": {
    "name": "projects",
    "displayName": "Projects",
    "description": "Project rail, per-project tabs, remote file browser and edit-in-place."
  },
  "author": "Tom Ganley-Lee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomganleylee/tabby-projects.git"
  },
  "homepage": "https://github.com/tomganleylee/tabby-projects#readme",
  "bugs": {
    "url": "https://github.com/tomganleylee/tabby-projects/issues"
  }
}
